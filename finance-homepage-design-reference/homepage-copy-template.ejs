<%#
  CraveMatch Home page layout — reusable template for Finance Tracker.
  Copy sections into your index.ejs. Replace placeholder text, images, and links.

  Requires:
  - Bootstrap 5 (grid + navbar collapse) OR equivalent layout
  - homepage-copy-style.css
  - homepage-copy-script.js
  - header/footer partials (or inline equivalents)
%>

<%- include('partials/header') %>

<main class="site-main home-page-pro">

  <!-- Hero slider -->
  <section class="hero-slider-section" id="heroSlider" aria-label="Home hero slider">
    <div class="hero-slides">

      <div class="hero-slide active" style="background-image: url('/hero/hero-budget.jpg');">
        <div class="hero-slide-overlay"></div>
        <div class="container hero-slide-inner">
          <div class="hero-slide-content">
            <span class="hero-slide-kicker">Personal finance dashboard</span>
            <h1 class="hero-slide-title">Manage Your Money With Confidence</h1>
            <p class="hero-slide-desc">
              Track spending, set monthly budgets with clear alerts, and make smarter purchase decisions in one place.
            </p>
            <div class="hero-slide-actions">
              <a href="/budget" class="hero-slide-btn hero-slide-btn-primary">Set Budget</a>
              <a href="/recommendation" class="hero-slide-btn hero-slide-btn-outline">View Recommendation</a>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-slide" style="background-image: url('/hero/hero-insights.jpg');">
        <div class="hero-slide-overlay"></div>
        <div class="container hero-slide-inner">
          <div class="hero-slide-content">
            <span class="hero-slide-kicker">Spending insight</span>
            <h1 class="hero-slide-title">Know Before You Buy</h1>
            <p class="hero-slide-desc">
              Check whether a purchase fits your budget with safe, risky, or not recommended guidance.
            </p>
            <div class="hero-slide-actions">
              <a href="/recommendation" class="hero-slide-btn hero-slide-btn-primary">Try Recommendation</a>
              <a href="/" class="hero-slide-btn hero-slide-btn-outline">View Dashboard</a>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-slide" style="background-image: url('/hero/hero-finbot.jpg');">
        <div class="hero-slide-overlay"></div>
        <div class="container hero-slide-inner">
          <div class="hero-slide-content">
            <span class="hero-slide-kicker">FinBot assistant</span>
            <h1 class="hero-slide-title">Ask FinBot For Finance Help</h1>
            <p class="hero-slide-desc">
              Get AI-assisted answers based on your budget, spending habits, and savings goals.
            </p>
            <div class="hero-slide-actions">
              <a href="/chatbot" class="hero-slide-btn hero-slide-btn-primary">Open FinBot</a>
              <a href="/budget" class="hero-slide-btn hero-slide-btn-outline">Open Budget</a>
            </div>
          </div>
        </div>
      </div>

    </div>

    <button type="button" class="hero-slider-arrow hero-slider-arrow-prev" aria-label="Previous slide" data-hero-direction="prev">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <button type="button" class="hero-slider-arrow hero-slider-arrow-next" aria-label="Next slide" data-hero-direction="next">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="hero-slider-dots" role="tablist" aria-label="Hero slides">
      <button type="button" class="hero-slider-dot active" data-hero-dot="0" aria-label="Slide 1"></button>
      <button type="button" class="hero-slider-dot" data-hero-dot="1" aria-label="Slide 2"></button>
      <button type="button" class="hero-slider-dot" data-hero-dot="2" aria-label="Slide 3"></button>
    </div>
  </section>

  <div class="container home-sections-wrap">

    <!-- Feature carousel -->
    <section class="home-section-block feature-slider-section">
      <div class="text-center mb-4 mb-lg-5">
        <p class="section-kicker">Features</p>
        <h2 class="home-section-title">What you can do</h2>
        <p class="home-section-lead">Explore the main Finance Tracker features in our continuous showcase.</p>
      </div>

      <% const homeFeatures = [
        {
          title: 'Budget Alerts',
          image: '/features/budgetAlert.png',
          desc: 'Set a monthly budget and get warning alerts when spending reaches 80% or goes over 100%.',
          btn: 'Open Budget',
          link: '/budget',
          color: 'green'
        },
        {
          title: 'Smart Recommendation',
          image: '/features/recommendation.jpg',
          desc: 'Check whether a purchase is safe, risky, or not recommended based on your remaining budget.',
          btn: 'Try Recommendation',
          link: '/recommendation',
          color: 'blue'
        },
        {
          title: 'FinBot Chatbot',
          image: '/features/cravebot.png',
          desc: 'Ask finance questions and get AI-assisted replies based on your budget and spending data.',
          btn: 'Open FinBot',
          link: '/chatbot',
          color: 'dark'
        },
        {
          title: 'Dashboard Analytics',
          image: '/features/dashboard.png',
          desc: 'View your total spending, remaining budget, and spending breakdown in one place.',
          btn: 'View Dashboard',
          link: '/',
          color: 'orange'
        },
        {
          title: 'Monthly Report',
          image: '/features/month_report_feature.jpg',
          desc: 'Review your monthly spending summary and understand where your money went.',
          btn: 'Coming soon',
          link: '#',
          color: 'yellow'
        },
        {
          title: 'Savings Goal',
          image: '/features/saving_goal_feature.jpg',
          desc: 'Set a saving target and track your progress toward reaching it.',
          btn: 'Coming soon',
          link: '#',
          color: 'green'
        }
      ]; %>

      <div class="feature-slider-wrap feature-carousel-wrapper" id="featureCarousel">
        <button id="featurePrevBtn" class="feature-slider-arrow feature-slider-arrow-prev" type="button" aria-label="Previous features">
          <span class="feature-slider-arrow-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>

        <div class="feature-carousel-window">
          <div class="feature-carousel-track" id="featureCarouselTrack">
            <% for (let i = 0; i < homeFeatures.length; i++) { %>
              <article class="feature-slide-card home-feature-card feature-slide-card-<%= homeFeatures[i].color %>">
                <div class="feature-slide-img-wrap">
                  <img src="<%= homeFeatures[i].image %>" class="feature-slide-img" alt="<%= homeFeatures[i].title %>">
                </div>
                <div class="feature-slide-body">
                  <h3 class="feature-slide-title"><%= homeFeatures[i].title %></h3>
                  <p class="feature-slide-desc"><%= homeFeatures[i].desc %></p>
                  <a href="<%= homeFeatures[i].link %>" class="feature-slide-btn feature-slide-btn-<%= homeFeatures[i].color %>">
                    <%= homeFeatures[i].btn %>
                  </a>
                </div>
              </article>
            <% } %>
            <% for (let i = 0; i < homeFeatures.length; i++) { %>
              <article class="feature-slide-card home-feature-card feature-slide-card-<%= homeFeatures[i].color %>" aria-hidden="true">
                <div class="feature-slide-img-wrap">
                  <img src="<%= homeFeatures[i].image %>" class="feature-slide-img" alt="">
                </div>
                <div class="feature-slide-body">
                  <h3 class="feature-slide-title"><%= homeFeatures[i].title %></h3>
                  <p class="feature-slide-desc"><%= homeFeatures[i].desc %></p>
                  <a href="<%= homeFeatures[i].link %>" class="feature-slide-btn feature-slide-btn-<%= homeFeatures[i].color %>" tabindex="-1">
                    <%= homeFeatures[i].btn %>
                  </a>
                </div>
              </article>
            <% } %>
          </div>
        </div>

        <button id="featureNextBtn" class="feature-slider-arrow feature-slider-arrow-next" type="button" aria-label="Next features">
          <span class="feature-slider-arrow-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
      </div>
    </section>

    <!-- Benefits / why section (optional — replace with Live snapshot in Finance Tracker) -->
    <section class="home-section-block benefit-showcase">
      <div class="row g-4 align-items-center">
        <div class="col-lg-5">
          <div class="benefit-showcase-image-wrap">
            <img src="/features/dashboard.png" class="benefit-showcase-img" alt="Finance Tracker dashboard preview">
          </div>
        </div>
        <div class="col-lg-7">
          <div class="benefit-showcase-content">
            <p class="section-kicker">Benefits</p>
            <h2 class="home-section-title">Why Finance Tracker helps</h2>
            <ul class="benefit-list-pro">
              <li><span class="benefit-check">✓</span><span>Set a monthly budget and get clear 80% and 100% alerts</span></li>
              <li><span class="benefit-check">✓</span><span>Check purchases before you buy with smart recommendations</span></li>
              <li><span class="benefit-check">✓</span><span>See spending totals and remaining budget on your dashboard</span></li>
              <li><span class="benefit-check">✓</span><span>Ask FinBot for quick finance guidance</span></li>
              <li><span class="benefit-check">✓</span><span>Track goals and monthly reports as features expand</span></li>
            </ul>
            <a href="/budget" class="btn btn-hero-primary btn-sm mt-2">Open Budget</a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <%# Optional: Live snapshot — wire to your existing summary object %>
  <% if (typeof summary !== 'undefined') { %>
  <section class="home-section-block container">
    <div class="text-center mb-4">
      <h2 class="home-section-title">Live snapshot</h2>
      <p class="home-section-lead">Current numbers from your budget and expenses.</p>
    </div>
    <div class="live-snapshot-grid">
      <article class="live-snapshot-card">
        <span class="live-snapshot-label">Monthly budget</span>
        <span class="live-snapshot-value">$<%= summary.monthlyBudget %></span>
      </article>
      <article class="live-snapshot-card">
        <span class="live-snapshot-label">Total spent</span>
        <span class="live-snapshot-value">$<%= summary.totalSpent %></span>
      </article>
      <article class="live-snapshot-card">
        <span class="live-snapshot-label">Remaining</span>
        <span class="live-snapshot-value live-snapshot-value--green">$<%= summary.remainingBudget %></span>
      </article>
      <article class="live-snapshot-card">
        <span class="live-snapshot-label">Budget used</span>
        <span class="live-snapshot-value"><%= summary.percentageUsed %>%</span>
      </article>
    </div>
  </section>
  <% } %>

</main>

<script src="/js/homepage-copy-script.js"></script>

<%- include('partials/footer') %>
