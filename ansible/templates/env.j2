# =============================================================
# SpendWise .env — generated by Ansible (do not edit manually)
# =============================================================

# Groq API key for FinBot chatbot
GROQ_API_KEY={{ groq_api_key }}

# MySQL database settings
# NOTE: this value is cosmetic only — the running app container gets its real
# DB_HOST injected directly at deploy time from the MySQL container's actual IP.
DB_HOST={{ db_host | default('127.0.0.1') }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_NAME={{ db_name }}
DB_PORT={{ db_port }}

# SMTP settings for budget email alerts
SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_SECURE={{ smtp_secure }}
SMTP_USER={{ smtp_user }}
SMTP_PASS={{ smtp_pass }}
SMTP_FROM={{ smtp_from }}

# App base URL for absolute links in budget alert emails
APP_BASE_URL={{ app_base_url }}

# App port
PORT={{ app_port }}