# Groq API key for FinBot
GROQ_API_KEY=your_groq_api_key_here

# Optional SMTP settings for budget email alerts (Profile → Email Budget Notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM=SpendWise <noreply@example.com>

# Use localhost if running with npm start
# Use host.docker.internal if running with Docker Desktop on Windows
DB_HOST=localhost
DB_USER=finance_user
DB_PASSWORD=password123
DB_NAME=finance_tracker
DB_PORT=3306