# Groq API key for FinBot
GROQ_API_KEY=your_groq_api_key_here

# Resend HTTPS API (preferred for production / Railway)
RESEND_API_KEY=
EMAIL_FROM=SpendWise <onboarding@resend.dev>

# Optional SMTP settings for local development fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=spendWise <your-sender-email@gmail.com>

# Public site URL for absolute links in emails (password reset, budget alerts).
# Local development:
APP_BASE_URL=http://localhost:3000
# Railway production: set APP_BASE_URL in the Railway dashboard to your public HTTPS domain
# (for example https://your-service.up.railway.app). Do not put production secrets in this file.

# Session cookie signing secret (set a strong unique value in production)
SESSION_SECRET=change-me-in-production

# MySQL database settings
# Use localhost if running with npm start
# Use host.docker.internal if running with Docker Desktop on Windows
DB_HOST=localhost
DB_USER=finance_user
DB_PASSWORD=your_password_here
DB_NAME=finance_tracker
DB_PORT=3306
