<%- include('partials/header') %>

<header class="page-header">
  <span class="eyebrow">Budget &amp; alerts</span>
  <h1>Monthly budget overview</h1>
  <p>Set your budget limit. Total spending is calculated from sample expenses automatically.</p>
</header>

<div class="status-banner status-banner--<%= summary.statusBadge %>">
  <div class="status-banner__icon">
    <% if (summary.statusBadge === 'success') { %>Γ£ô<% } %>
    <% if (summary.statusBadge === 'warning') { %>ΓÜá<% } %>
    <% if (summary.statusBadge === 'danger') { %>Γ£ò<% } %>
  </div>
  <div>
    <strong>Alert status: <%= summary.statusLabel %></strong>
    <% if (summary.alert.message) { %>
    <p><%= summary.alert.message %></p>
    <% } else { %>
    <p>You are below 80% of your monthly budget. Spending is under control.</p>
    <% } %>
  </div>
</div>

<div class="stat-grid">
  <article class="stat-card">
    <span class="stat-card__label">Monthly budget</span>
    <span class="stat-card__value stat-card__value--blue">$<%= summary.monthlyBudget %></span>
  </article>
  <article class="stat-card">
    <span class="stat-card__label">Total spent</span>
    <span class="stat-card__value stat-card__value--blue">$<%= summary.totalSpent %></span>
  </article>
  <article class="stat-card">
    <span class="stat-card__label">Remaining budget</span>
    <span class="stat-card__value stat-card__value--<%= summary.remainingBudget >= 0 ? 'green' : 'red' %>">$<%= summary.remainingBudget %></span>
  </article>
  <article class="stat-card">
    <span class="stat-card__label">Budget used</span>
    <span class="stat-card__value"><%= summary.percentageUsed %>%</span>
    <span class="pill pill--<%= summary.statusBadge %>"><%= summary.statusLabel %></span>
  </article>
</div>

<div class="split-layout">
  <section class="card-panel">
    <h2>Monthly budget setup</h2>
    <p class="card-panel__intro">Set your spending limit for the month. This is the only value you enter manually.</p>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="form-errors">
      <% errors.forEach(function(error) { %>
        <p><%= error %></p>
      <% }); %>
    </div>
    <% } %>

    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="form-success"><%= successMessage %></div>
    <% } %>

    <form class="form form--budget" method="POST" action="/budget">
      <div class="form-group">
        <label for="monthlyBudget">Monthly budget ($)</label>
        <input
          type="number"
          id="monthlyBudget"
          name="monthlyBudget"
          min="0.01"
          step="0.01"
          required
          value="<%= typeof formValues !== 'undefined' && formValues.monthlyBudget !== undefined ? formValues.monthlyBudget : summary.monthlyBudget %>"
        >
      </div>
      <button type="submit" class="btn btn--primary btn--block">Save monthly budget</button>
    </form>
  </section>

  <section class="card-panel">
    <h2>Spending progress</h2>
    <div class="progress-meta">
      <strong>$<%= summary.totalSpent %> of $<%= summary.monthlyBudget %></strong>
      <span class="pill pill--<%= summary.statusBadge %>"><%= summary.percentageUsed %>%</span>
    </div>
    <div class="progress-bar">
      <div class="progress-bar__fill <%= summary.progressClass %> <%= summary.progressWidthClass %>"></div>
    </div>
    <ul class="rule-list">
      <li><span class="pill pill--success">Safe</span> Below 80% used</li>
      <li><span class="pill pill--warning">Warning</span> 80% ΓÇô 99% used</li>
      <li><span class="pill pill--danger">Overspending</span> 100% or more</li>
    </ul>
  </section>
</div>

<section class="card-panel">
  <h2>Sample expenses</h2>
  <p class="card-panel__intro">Demo transactions from the backend. Total spent = sum of all amounts below.</p>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Description</th>
          <th>Category</th>
          <th class="data-table__right">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% expenses.forEach(function(expense) { %>
        <tr>
          <td><%= expense.description %></td>
          <td><span class="tag tag--blue"><%= expense.category %></span></td>
          <td class="data-table__right data-table__amount">$<%= expense.amount %></td>
        </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2"><strong>Total spent</strong></td>
          <td class="data-table__right data-table__amount"><strong>$<%= summary.totalSpent %></strong></td>
        </tr>
      </tfoot>
    </table>
  </div>
</section>

<%- include('partials/footer') %>
