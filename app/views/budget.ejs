<%- include('partials/header') %>

<section class="page-hero">
  <span class="page-label">Budget</span>
  <h1>Budget &amp; Alerts</h1>
  <p>Set your monthly budget. Total spending is calculated automatically from sample expenses until the database is ready.</p>
</section>

<section class="panel">
  <h2>Monthly budget setup</h2>
  <p class="panel-intro">Enter your monthly budget only. Spending comes from the sample expense list below (no database yet).</p>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="form-errors">
    <% errors.forEach(function(error) { %>
      <p><%= error %></p>
    <% }); %>
  </div>
  <% } %>

  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
  <div class="form-success"><%= successMessage %></div>
  <% } %>

  <form class="budget-form" method="POST" action="/budget">
    <div class="form-group">
      <label for="monthlyBudget">Monthly budget ($)</label>
      <input
        type="number"
        id="monthlyBudget"
        name="monthlyBudget"
        min="0.01"
        step="0.01"
        required
        value="<%= typeof formValues !== 'undefined' && formValues.monthlyBudget !== undefined ? formValues.monthlyBudget : summary.monthlyBudget %>"
      >
    </div>
    <button type="submit" class="btn btn--primary">Update budget</button>
  </form>
</section>

<% if (summary.alert.type !== 'safe') { %>
<section class="alert-banner alert-banner--<%= summary.alert.type === 'warning' ? 'warning' : 'danger' %>">
  <strong><%= summary.statusLabel %> alert:</strong> <%= summary.alert.message %>
</section>
<% } %>

<div class="card-grid">
  <article class="card">
    <div class="card__icon card__icon--blue">📅</div>
    <h2>Monthly budget</h2>
    <p class="stat stat--blue">$<%= summary.monthlyBudget %></p>
    <p>Your current monthly spending limit.</p>
  </article>
  <article class="card">
    <div class="card__icon card__icon--blue">🛒</div>
    <h2>Total spent</h2>
    <p class="stat stat--blue">$<%= summary.totalSpent %></p>
    <p>Sum of all sample expenses below.</p>
  </article>
  <article class="card">
    <div class="card__icon card__icon--green">📈</div>
    <span class="badge badge--<%= summary.statusBadge %>"><%= summary.statusLabel %></span>
    <h2>Budget used</h2>
    <p class="stat stat--<%= summary.statusBadge === 'success' ? 'green' : 'blue' %>"><%= summary.percentageUsed %>%</p>
    <p>(<%= summary.totalSpent %> ÷ <%= summary.monthlyBudget %>) × 100</p>
  </article>
  <article class="card">
    <div class="card__icon card__icon--green">🔔</div>
    <h2>Remaining</h2>
    <p class="stat stat--<%= summary.remainingBudget >= 0 ? 'green' : 'blue' %>">$<%= summary.remainingBudget %></p>
    <p><%= summary.remainingBudget >= 0 ? 'Amount left in your budget.' : 'Amount over your budget.' %></p>
  </article>
</div>

<section class="panel">
  <h2>Sample expenses</h2>
  <p class="panel-intro">These demo expenses are stored in the backend. Total spent = sum of all amounts.</p>
  <table class="expense-table">
    <thead>
      <tr>
        <th>Description</th>
        <th>Category</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% expenses.forEach(function(expense) { %>
      <tr>
        <td><%= expense.description %></td>
        <td><span class="badge badge--blue"><%= expense.category %></span></td>
        <td class="expense-table__amount">$<%= expense.amount %></td>
      </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="2"><strong>Total spent</strong></td>
        <td class="expense-table__amount"><strong>$<%= summary.totalSpent %></strong></td>
      </tr>
    </tfoot>
  </table>
</section>

<div class="panel-grid">
  <section class="panel">
    <h2>Spending progress</h2>
    <div class="progress-header">
      <strong>$<%= summary.totalSpent %> of $<%= summary.monthlyBudget %></strong>
      <span class="badge badge--<%= summary.statusBadge %>"><%= summary.percentageUsed %>% used</span>
    </div>
    <div class="progress-bar">
      <div class="progress-bar__fill <%= summary.progressClass %> <%= summary.progressWidthClass %>"></div>
    </div>
    <p class="note note--inline">
      <strong>Safe</strong> below 80%. <strong>Warning</strong> from 80% to 99%. <strong>Overspending</strong> at 100% or more.
    </p>
  </section>

  <section class="panel">
    <h2>Status rules</h2>
    <div class="alert-rules">
      <div class="alert-rule">
        <span class="badge badge--success">Below 80%</span>
        <span>Safe — spending is under control</span>
      </div>
      <div class="alert-rule">
        <span class="badge badge--warning">80% – 99%</span>
        <span>Warning — consider slowing down spending</span>
      </div>
      <div class="alert-rule">
        <span class="badge badge--danger">100%+</span>
        <span>Overspending — review your expenses</span>
      </div>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
