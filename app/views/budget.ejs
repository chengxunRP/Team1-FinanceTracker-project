<%- include('partials/header') %>

<%
  if (typeof categoryRows === 'undefined') categoryRows = [];
  if (typeof hasCategoryBudgets === 'undefined') hasCategoryBudgets = false;
  if (typeof budgetMonth === 'undefined') budgetMonth = '';
  if (typeof budgetMonthLabel === 'undefined') budgetMonthLabel = budgetMonth;
  if (typeof successMessage === 'undefined') successMessage = '';
  if (typeof everythingElse === 'undefined') everythingElse = { amount: 0, categoryCount: 0, label: 'Other categories' };
  if (typeof budgetTotals === 'undefined') budgetTotals = { totalSpent: 0, totalBudgeted: 0 };
  if (typeof availableCategories === 'undefined') availableCategories = [];
  if (typeof overallBudgetSection === 'undefined') overallBudgetSection = null;

  var currentMonthName = budgetMonthLabel.split(' ')[0] || 'this month';
%>

<div class="spb-page">
  <header class="spb-topbar">
    <h1 class="spb-topbar__title">Spending &amp; Budgets</h1>
    <button type="button" class="spb-topbar__add" id="openAddBudget" aria-label="Add a budget">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
    </button>
  </header>

  <%- include('partials/budget-notifications', { budgetNotifications: typeof budgetNotifications !== 'undefined' ? budgetNotifications : { alerts: [], hasAlerts: false }, showBudgetAlertsEmpty: true }) %>

  <div class="spb-page__body">

  <section class="spb-summary">
    <h2 class="spb-summary__title">Budgets &bull; <strong><%= formatMoney(budgetTotals.totalSpent) %></strong></h2>
    <p class="spb-summary__sub">of <%= formatMoney(budgetTotals.totalBudgeted) %> budgeted</p>
  </section>

  <% if (!hasCategoryBudgets) { %>
  <section class="spb-empty">
    <p class="spb-empty__text">Allocate a portion of money out of your income in order to budget for spending categories like Groceries, Auto &amp; Transport, Entertainment, or Eating out.</p>
    <button type="button" class="spb-btn spb-btn--primary" id="openAddBudgetEmpty">Add a budget</button>
    <aside class="spb-protip">
      <span class="spb-protip__label">PRO TIP:</span>
      <span class="spb-protip__text">do not track your recurring expenses (bills) and variable expenses (budgets) under the same category to avoid double-counting of your monthly plan (Leftover).</span>
    </aside>
  </section>
  <% } else { %>
  <section class="spb-cards" aria-label="Category budgets">
    <div class="spb-cards__grid">
      <% categoryRows.forEach(function(row) {
        var isBudgetDanger = row.overspent || row.statusKey === 'reached';
        var cardClass = row.overspent ? 'spb-card--overspent' : (isBudgetDanger ? 'spb-card--overspent' : (row.showWarning && row.statusKey === 'warning' ? 'spb-card--warning' : ''));
        var ringR = 29;
        var ringC = 2 * Math.PI * ringR;
        var ringPct = Math.min(Math.max(row.usedPct || 0, 0), 100);
        var ringOffset = ringC * (1 - ringPct / 100);
        var ringFillClass = isBudgetDanger ? 'spb-ring__fill--danger' : (row.showWarning && row.statusKey === 'warning' ? 'spb-ring__fill--warning' : 'spb-ring__fill--default');
        var ringWrapClass = isBudgetDanger ? ' spb-card__ring-wrap--alert' : (row.showWarning && row.statusKey === 'warning' ? ' spb-card__ring-wrap--warning' : '');
      %>
      <a href="/budget/categories/<%= row.categoryId %>?month=<%= budgetMonth %>" class="spb-card <%= cardClass %>">
        <div class="spb-card__ring-wrap<%= ringWrapClass %>">
          <svg class="spb-ring" viewBox="0 0 74 74" aria-hidden="true">
            <circle class="spb-ring__track" cx="37" cy="37" r="29" fill="none" stroke-width="4"/>
            <circle class="spb-ring__fill <%= ringFillClass %>" cx="37" cy="37" r="29" fill="none" stroke-width="4" stroke-dasharray="<%= ringC %>" stroke-dashoffset="<%= ringOffset %>" transform="rotate(-90 37 37)"/>
          </svg>
          <div class="spb-card__ring-icon">
            <%- include('partials/category-icon', { catName: row.displayName || row.name, catIcon: row.icon, catIconImage: row.iconImage, catColor: row.isCustom ? row.color : '', catIsCustom: row.isCustom, catSize: 'md' }) %>
          </div>
        </div>
        <div class="spb-card__body">
          <span class="spb-card__name"><%= row.displayName %></span>
          <span class="spb-card__status"><%= row.statusMessage %></span>
          <% if (row.rolloverEnabled && row.rollover !== 0) { %>
          <span class="spb-card__rollover"><%= row.rollover > 0 ? '+' : '' %><%= formatMoney(row.rollover) %> rollover</span>
          <% } %>
          <% if (row.warningMessage) { %>
          <span class="spb-card__warning"><%= row.warningMessage %></span>
          <% } %>
        </div>
        <div class="spb-card__amounts">
          <span class="spb-card__spent"><%= formatMoney(row.actual) %></span>
          <span class="spb-card__limit">of <%= formatMoney(row.availableBudget) %></span>
        </div>
      </a>
      <% }); %>
    </div>
  </section>
  <% } %>

  <% if (overallBudgetSection) {
    var overallRow = overallBudgetSection.card;
    var overallIsDanger = overallRow.overspent || overallRow.statusKey === 'reached';
    var overallCardClass = overallRow.overspent ? 'spb-card--overspent' : (overallIsDanger ? 'spb-card--overspent' : (overallRow.showWarning && overallRow.statusKey === 'warning' ? 'spb-card--warning' : ''));
    var overallRingR = 29;
    var overallRingC = 2 * Math.PI * overallRingR;
    var overallRingPct = Math.min(Math.max(overallRow.usedPct || 0, 0), 100);
    var overallRingOffset = overallRingC * (1 - overallRingPct / 100);
    var overallRingFillClass = overallIsDanger ? 'spb-ring__fill--danger' : (overallRow.showWarning && overallRow.statusKey === 'warning' ? 'spb-ring__fill--warning' : 'spb-ring__fill--default');
    var overallRingWrapClass = overallIsDanger ? ' spb-card__ring-wrap--alert' : (overallRow.showWarning && overallRow.statusKey === 'warning' ? ' spb-card__ring-wrap--warning' : '');
  %>
  <section class="spb-summary spb-summary--overall">
    <h2 class="spb-summary__title">All Categories Budget &bull; <strong><%= formatMoney(overallBudgetSection.spent) %></strong></h2>
    <p class="spb-summary__sub">of <%= formatMoney(overallBudgetSection.budgeted) %> <%= overallBudgetSection.budgetSubtitle || 'budgeted' %></p>
  </section>
  <section class="spb-cards spb-cards--overall" aria-label="All Categories budget">
    <div class="spb-cards__grid">
      <a href="/budget/all-categories?month=<%= encodeURIComponent(budgetMonth) %>" class="spb-card <%= overallCardClass %>" aria-label="All Transactions">
        <div class="spb-card__ring-wrap<%= overallRingWrapClass %>">
          <svg class="spb-ring" viewBox="0 0 74 74" aria-hidden="true">
            <circle class="spb-ring__track" cx="37" cy="37" r="29" fill="none" stroke-width="4"/>
            <circle class="spb-ring__fill <%= overallRingFillClass %>" cx="37" cy="37" r="29" fill="none" stroke-width="4" stroke-dasharray="<%= overallRingC %>" stroke-dashoffset="<%= overallRingOffset %>" transform="rotate(-90 37 37)"/>
          </svg>
          <div class="spb-card__ring-icon">
            <%- include('partials/category-icon', { catName: overallRow.displayName, catIconImage: overallRow.iconImage, catSize: 'md' }) %>
          </div>
        </div>
        <div class="spb-card__body">
          <span class="spb-card__name"><%= overallRow.displayName %></span>
          <span class="spb-card__status"><%= overallRow.statusMessage %></span>
          <% if (overallRow.rolloverEnabled && overallRow.rollover !== 0) { %>
          <span class="spb-card__rollover"><%= overallRow.rollover > 0 ? '+' : '' %><%= formatMoney(overallRow.rollover) %> rollover</span>
          <% } %>
          <% if (overallRow.warningMessage) { %>
          <span class="spb-card__warning"><%= overallRow.warningMessage %></span>
          <% } %>
        </div>
        <div class="spb-card__amounts">
          <span class="spb-card__spent"><%= formatMoney(overallRow.actual) %></span>
          <span class="spb-card__limit">of <%= formatMoney(overallRow.availableBudget) %></span>
        </div>
      </a>
    </div>
  </section>
  <% } %>

  <section class="spb-elsewhere">
    <h2 class="spb-elsewhere__title">Everything else &bull; <%= formatMoney(everythingElse.amount) %></h2>
    <a href="/budget/everything-else?month=<%= encodeURIComponent(budgetMonth) %>&returnMonth=<%= encodeURIComponent(budgetMonth) %>" class="spb-elsewhere__card everything-card" aria-label="View unbudgeted spending">
      <div class="spb-elsewhere__row">
        <span class="spb-elsewhere__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><circle cx="7" cy="7" r="1.5" fill="currentColor"/></svg>
        </span>
        <span class="spb-elsewhere__label"><%= everythingElse.categoryCount > 0 ? everythingElse.label : 'Other categories' %></span>
        <span class="spb-elsewhere__amount"><%= formatMoney(everythingElse.amount) %></span>
        <svg class="spb-elsewhere__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <p class="spb-elsewhere__hint">Spending in unbudgeted categories falls here.</p>
    </a>
  </section>
  </div>
</div>

<%- include('partials/add-budget-modal', { availableCategories: availableCategories, budgetMonth: budgetMonth, budgetMonthLabel: budgetMonthLabel, currentMonthName: currentMonthName, hasOverallBudget: !!overallBudgetSection }) %>

<script id="budgetPageData" type="application/json"><%- JSON.stringify({ budgetMonth: budgetMonth, availableCategories: availableCategories, currentMonthName: currentMonthName }) %></script>
<script src="/js/category-colours.js"></script>
<script src="/js/modal-scroll.js?v=3"></script>
<script src="/js/budget.js?v=27"></script>
<script src="/js/budget-notifications.js?v=9"></script>
<script src="/js/budget-notifications-ui.js?v=8"></script>

<%- include('partials/footer') %>
