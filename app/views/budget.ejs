<%- include('partials/header') %>

<%
  var categoryRows = [
    { name: 'Food', icon: 'food', budgeted: 180, categories: ['Food'] },
    { name: 'Transport', icon: 'transport', budgeted: 100, categories: ['Transport'] },
    { name: 'Dining', icon: 'dining', budgeted: 100, categories: ['Dining'] },
    { name: 'Shopping', icon: 'shopping', budgeted: 120, categories: ['Shopping'] },
    { name: 'Bills', icon: 'bills', budgeted: 80, categories: ['Utilities', 'Bills'] },
    { name: 'Entertainment', icon: 'entertainment', budgeted: 50, categories: ['Entertainment'] }
  ];

  function budgetIconSvg(type) {
    var icons = {
      budget: '<svg class="budget-cat-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M8 3v4M16 3v4M4 10h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>',
      spend: '<svg class="budget-cat-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.75"/><path d="M7 15h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>',
      food: '<svg class="budget-cat-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21c4-4 6-7.5 6-11a6 6 0 10-12 0c0 3.5 2 7 6 11z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M12 13a2 2 0 100-4 2 2 0 000 4z" stroke="currentColor" stroke-width="1.75"/></svg>',
      transport: '<svg class="budget-cat-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 17h14M5 17a2 2 0 100-4 2 2 0 000 4zM19 17a2 2 0 100-4 2 2 0 000 4zM5 17V8l2-3h10l2 3v9" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M7 8h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>',
      dining: '<svg class="budget-cat-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 4v8M6 4v5M10 4v5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><path d="M8 12v8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><path d="M16 4c1.5 2 2 4 2 7v9" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>',
      shopping: '<svg class="budget-cat-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 9V7a5 5 0 0110 0v2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><path d="M6 9h12l-1 12H7L6 9z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>',
      bills: '<svg class="budget-cat-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 4h8l2 4v12H6V4h2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M9 12h6M9 16h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>',
      entertainment: '<svg class="budget-cat-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="6" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M10 9.5l5 3-5 3v-6z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>'
    };
    return icons[type] || icons.spend;
  }

  function getCategoryActual(expenseList, names) {
    var total = 0;
    for (var i = 0; i < expenseList.length; i++) {
      if (names.indexOf(expenseList[i].category) >= 0) {
        total += expenseList[i].amount;
      }
    }
    return total;
  }

  function formatMoney(value) {
    var num = Number(value);
    if (Number.isNaN(num)) {
      return '$0';
    }
    var text = num.toFixed(2);
    if (text.slice(-3) === '.00') {
      return '$' + text.slice(0, -3);
    }
    return '$' + text;
  }

  function formatRemaining(value, includeOverspentLabel) {
    var num = Number(value);
    if (Number.isNaN(num)) {
      return '$0';
    }
    if (num < 0) {
      var overspentText = formatMoney(Math.abs(num)).replace('$', '-$');
      return includeOverspentLabel !== false ? overspentText + ' overspent' : overspentText;
    }
    return formatMoney(num);
  }

  function getRemainingClass(remaining, usedPct) {
    if (remaining < 0) {
      return 'budget-amount--danger';
    }
    if (usedPct >= 80) {
      return 'budget-amount--warning';
    }
    return 'budget-amount--green';
  }

  function getExpenseIcon(category) {
    var icons = {
      Food: { icon: 'food' },
      Transport: { icon: 'transport' },
      Dining: { icon: 'dining' },
      Shopping: { icon: 'shopping' },
      Utilities: { icon: 'bills' },
      Bills: { icon: 'bills' },
      Entertainment: { icon: 'entertainment' }
    };
    return icons[category] || { icon: 'spend' };
  }

  function getBudgetCategoryLabel(category) {
    if (category === 'Utilities') {
      return 'Bills';
    }
    return category;
  }

  function getExpenseDisplayName(description) {
    var labels = {
      'Weekly groceries': 'Food expense',
      'Bus pass': 'Transport expense',
      'Restaurant dinner': 'Dining expense',
      'Electric bill': 'Bills expense'
    };
    return labels[description] || description;
  }

  function getRowStatus(usedPct) {
    if (usedPct >= 100) {
      return { ring: 'danger' };
    }
    if (usedPct >= 80) {
      return { ring: 'warning' };
    }
    return { ring: 'safe' };
  }

  var spendingStatus = getRowStatus(summary.percentageUsed);
  var monthlyRemainingClass = getRemainingClass(summary.remainingBudget, summary.percentageUsed);

  var monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  var now = new Date();
  var monthTitle = monthNames[now.getMonth()] + ' ' + now.getFullYear() + ' Budget';
%>

<div class="budget-page">
  <header class="budget-page-header">
    <div class="budget-page-header__text">
      <span class="budget-page-eyebrow">Budget &amp; alerts</span>
      <h1 class="budget-page-title">Monthly Budget</h1>
      <p class="budget-page-subtitle">Track your spending limit, monitor actual spending, and see how much is left before overspending.</p>
    </div>
    <div class="budget-month-nav" aria-label="Month selector (visual only)">
      <button type="button" class="budget-month-nav__arrow" id="budgetMonthPrev" aria-label="Previous month">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <span class="budget-month-nav__label" id="budgetMonthLabel"><%= monthTitle %></span>
      <button type="button" class="budget-month-nav__arrow" id="budgetMonthNext" aria-label="Next month">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </header>

  <div class="budget-alert-banner budget-alert-banner--<%= summary.statusBadge %>">
    <div class="budget-alert-banner__icon" aria-hidden="true">
      <% if (summary.statusBadge === 'success') { %>&#10003;<% } %>
      <% if (summary.statusBadge === 'warning') { %>&#9888;<% } %>
      <% if (summary.statusBadge === 'danger') { %>&#10005;<% } %>
    </div>
    <div>
      <strong>Alert status: <%= summary.statusLabel %></strong>
      <% if (summary.statusBadge === 'success') { %>
      <p>You are below 80% of your monthly budget. Spending is under control.</p>
      <% } else if (summary.statusBadge === 'warning') { %>
      <p>You have used 80% or more of your budget. Be careful with new purchases.</p>
      <% } else { %>
      <p>You have gone over your monthly budget. Reduce spending where possible.</p>
      <% } %>
    </div>
  </div>

  <div class="budget-layout">
    <div class="budget-layout__main">
      <section class="budget-card budget-card--tables">
        <div class="budget-table-section">
          <h2 class="budget-card__title">Budget Basics</h2>
          <div class="budget-table-wrap">
            <table class="budget-table">
              <thead>
                <tr>
                  <th class="budget-table__col-name">Name</th>
                  <th class="budget-table__col-num">Budget Limit</th>
                  <th class="budget-table__col-num">Actual Spent</th>
                  <th class="budget-table__col-num">Remaining</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="budget-table__name">
                    <span class="budget-cat-icon budget-cat-icon--budget" aria-hidden="true"><%- budgetIconSvg('budget') %></span>
                    <span class="budget-row-link" role="button" tabindex="0">Monthly Budget</span>
                  </td>
                  <td class="budget-table__cell budget-table__cell--budgeted">
                    <span class="budget-amount budget-amount--budgeted"><%= formatMoney(summary.monthlyBudget) %></span>
                  </td>
                  <td class="budget-table__cell budget-table__cell--actual">
                    <span class="budget-amount"><%= formatMoney(summary.totalSpent) %><span class="budget-amount__suffix"> spent</span></span>
                  </td>
                  <td class="budget-table__cell budget-table__cell--remaining">
                    <div class="budget-remaining-wrap">
                      <span class="budget-amount <%= monthlyRemainingClass %>"><%= formatRemaining(summary.remainingBudget) %></span>
                      <span class="budget-ring budget-ring--<%= spendingStatus.ring %><%= summary.percentageUsed >= 100 ? ' budget-ring--full' : '' %>" style="--ring-pct: <%= Math.min(summary.percentageUsed, 100) %>;" aria-hidden="true"></span>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="budget-table-section budget-table-section--divider">
          <h2 class="budget-card__title">Budget Categories</h2>
          <p class="budget-table-helper">Category remaining is calculated from your existing expense items.</p>
          <div class="budget-table-wrap">
            <table class="budget-table">
              <thead>
                <tr>
                  <th class="budget-table__col-name">Name</th>
                  <th class="budget-table__col-num">Budget Limit</th>
                  <th class="budget-table__col-num">Actual Spent</th>
                  <th class="budget-table__col-num">Remaining</th>
                </tr>
              </thead>
              <tbody>
                <% categoryRows.forEach(function(row) {
                  var actual = getCategoryActual(expenses, row.categories);
                  var remaining = row.budgeted - actual;
                  var usedPct = row.budgeted > 0 ? Math.round((actual / row.budgeted) * 100) : 0;
                  var rowStatus = getRowStatus(usedPct);
                  var remainClass = getRemainingClass(remaining, usedPct);
                %>
                <tr>
                  <td class="budget-table__name">
                    <span class="budget-cat-icon budget-cat-icon--<%= row.icon %>" aria-hidden="true"><%- budgetIconSvg(row.icon) %></span>
                    <span class="budget-row-link" role="button" tabindex="0"><%= row.name %></span>
                  </td>
                  <td class="budget-table__cell budget-table__cell--budgeted">
                    <span class="budget-amount budget-amount--budgeted"><%= formatMoney(row.budgeted) %></span>
                  </td>
                  <td class="budget-table__cell budget-table__cell--actual">
                    <span class="budget-amount"><%= formatMoney(actual) %><% if (actual > 0) { %><span class="budget-amount__suffix"> spent</span><% } %></span>
                  </td>
                  <td class="budget-table__cell budget-table__cell--remaining">
                    <div class="budget-remaining-wrap">
                      <span class="budget-amount <%= remainClass %>"><%= formatRemaining(remaining) %></span>
                      <span class="budget-ring budget-ring--<%= rowStatus.ring %><%= usedPct >= 100 ? ' budget-ring--full' : '' %>" style="--ring-pct: <%= Math.min(usedPct, 100) %>;" aria-hidden="true"></span>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>

    <aside class="budget-layout__side">
      <section class="budget-summary-card">
        <h2 class="budget-card__title">Summary</h2>

        <div class="budget-donut-wrap">
          <div class="budget-donut budget-donut--<%= spendingStatus.ring %>" style="--used: <%= Math.min(summary.percentageUsed, 100) %>;" role="img" aria-label="<%= summary.percentageUsed %>% of monthly budget spent">
            <div class="budget-donut__hole">
              <span class="budget-donut__label">Budget Used</span>
              <span class="budget-donut__value"><%= summary.percentageUsed %>%</span>
              <span class="budget-donut__of"><%= formatMoney(summary.totalSpent) %> of <%= formatMoney(summary.monthlyBudget) %></span>
            </div>
          </div>
        </div>

        <p class="budget-used-note"><%= formatMoney(summary.totalSpent) %> spent &middot; <%= formatRemaining(summary.remainingBudget, false) %> left</p>

        <ul class="budget-summary-list">
          <li>
            <span class="budget-summary-list__label"><span class="budget-summary-icon budget-summary-icon--plus" aria-hidden="true">+</span> Spending Budget</span>
            <span class="budget-summary-list__value"><%= formatMoney(summary.monthlyBudget) %></span>
          </li>
          <li>
            <span class="budget-summary-list__label"><span class="budget-summary-icon budget-summary-icon--minus" aria-hidden="true">&minus;</span> Current Spend</span>
            <span class="budget-summary-list__value budget-summary-list__value--red"><%= formatMoney(summary.totalSpent) %></span>
          </li>
          <li class="budget-summary-list__total">
            <span class="budget-summary-list__label"><span class="budget-summary-icon budget-summary-icon--eq" aria-hidden="true">=</span> Remaining</span>
            <span class="budget-summary-list__value budget-summary-list__value--<%= summary.remainingBudget < 0 ? 'danger' : (summary.percentageUsed >= 80 ? 'warning' : 'green') %>"><%= formatRemaining(summary.remainingBudget, summary.remainingBudget < 0) %></span>
          </li>
        </ul>
      </section>

      <section class="budget-card budget-card--form budget-card--sidebar">
        <h2 class="budget-card__title budget-card__title--form">Monthly Budget Setup</h2>
        <p class="budget-card__intro">Set your spending limit for the month. This is the only value you enter manually.</p>

        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="form-errors">
          <% errors.forEach(function(error) { %>
            <p><%= error %></p>
          <% }); %>
        </div>
        <% } %>

        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="form-success"><%= successMessage %></div>
        <% } %>

        <form class="form form--budget budget-setup-form" method="POST" action="/budget">
          <div class="form-group">
            <label for="monthlyBudget">Monthly budget ($)</label>
            <input
              type="number"
              id="monthlyBudget"
              name="monthlyBudget"
              min="0.01"
              step="0.01"
              required
              value="<%= typeof formValues !== 'undefined' && formValues.monthlyBudget !== undefined ? formValues.monthlyBudget : summary.monthlyBudget %>"
            >
          </div>
          <button type="submit" class="btn btn--primary btn--block">Save monthly budget</button>
        </form>
      </section>
    </aside>
  </div>

  <section class="budget-card budget-card--expenses budget-card--expense-records">
    <div class="budget-expense-head">
      <div>
        <h2 class="budget-expense-records__title">Expense Records Used for Calculation</h2>
        <p class="budget-expense-records__intro">These are the existing expense records used to calculate the category totals above.</p>
      </div>
      <span class="budget-expense-count"><%= expenses.length %> record<%= expenses.length === 1 ? '' : 's' %></span>
    </div>

    <ul class="budget-expense-list budget-expense-list--compact">
      <% expenses.forEach(function(expense) {
        var expenseIcon = getExpenseIcon(expense.category);
        var budgetCategory = getBudgetCategoryLabel(expense.category);
      %>
      <li class="budget-expense-item">
        <span class="budget-cat-icon budget-cat-icon--sm budget-cat-icon--<%= expenseIcon.icon %>" aria-hidden="true"><%- budgetIconSvg(expenseIcon.icon) %></span>
        <div class="budget-expense-item__main">
          <span class="budget-expense-item__title"><%= getExpenseDisplayName(expense.description) %></span>
          <span class="budget-expense-item__meta"><span class="budget-tag budget-tag--<%= expenseIcon.icon %>"><%= budgetCategory %></span></span>
        </div>
        <span class="budget-expense-item__amount"><%= formatMoney(expense.amount) %></span>
      </li>
      <% }); %>
    </ul>

    <div class="budget-expense-total budget-expense-total--compact">
      <span class="budget-expense-total__label">Total spent</span>
      <span class="budget-expense-total__value"><%= formatMoney(summary.totalSpent) %></span>
    </div>
  </section>
</div>

<script>
(function () {
  "use strict";
  var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  var monthIndex = new Date().getMonth();
  var year = new Date().getFullYear();
  var label = document.getElementById("budgetMonthLabel");
  var prevBtn = document.getElementById("budgetMonthPrev");
  var nextBtn = document.getElementById("budgetMonthNext");

  function updateLabel() {
    if (label) {
      label.textContent = months[monthIndex] + " " + year + " Budget";
    }
  }

  if (prevBtn) {
    prevBtn.addEventListener("click", function () {
      monthIndex -= 1;
      if (monthIndex < 0) {
        monthIndex = 11;
        year -= 1;
      }
      updateLabel();
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener("click", function () {
      monthIndex += 1;
      if (monthIndex > 11) {
        monthIndex = 0;
        year += 1;
      }
      updateLabel();
    });
  }
})();
</script>

<%- include('partials/footer') %>
