<%- include('partials/header') %>

<%
  if (typeof categoryRows === 'undefined') categoryRows = [];
  if (typeof categorySpending === 'undefined') categorySpending = [];
  if (typeof hasCategoryBudgets === 'undefined') hasCategoryBudgets = false;
  if (typeof budgetMonth === 'undefined') budgetMonth = '';
  if (typeof monthExpenseCount === 'undefined') monthExpenseCount = 0;
  if (typeof budgetMonthLabel === 'undefined') budgetMonthLabel = budgetMonth;
  if (typeof healthStatus === 'undefined') healthStatus = { label: 'On track', key: 'safe', helper: 'Spending is within your budget' };
  if (typeof successMessage === 'undefined') successMessage = '';

  function formatMoney(value) {
    var num = Number(value);
    if (Number.isNaN(num)) return '$0';
    var text = num.toFixed(2);
    if (text.slice(-3) === '.00') return '$' + text.slice(0, -3);
    return '$' + text;
  }

  function formatRemaining(value, includeOverspentLabel) {
    var num = Number(value);
    if (Number.isNaN(num)) return '$0';
    if (num < 0) {
      var overspentText = formatMoney(Math.abs(num)).replace('$', '-$');
      return includeOverspentLabel !== false ? overspentText + ' overspent' : overspentText;
    }
    return formatMoney(num);
  }

  function getBudgetCategoryLabel(category) {
    if (category === 'Utilities') return 'Bills';
    return category;
  }

  var monthTitle = budgetMonthLabel + ' Budget';
  var remainingKey = summary.remainingBudget < 0 ? 'danger' : (summary.percentageUsed >= 80 ? 'warning' : 'safe');
  var setupUrl = '/budget/setup' + (budgetMonth ? '?month=' + budgetMonth : '');
%>

<div class="budget-page budget-page--tracker budget-page--full">
  <header class="budget-page-header">
    <div class="budget-page-header__text">
      <span class="budget-page-eyebrow">Budget &amp; alerts</span>
      <h1 class="budget-page-title">Budget Alerts</h1>
      <p class="budget-page-subtitle">Monitor your monthly limit, track category spending, and catch overspending before it happens.</p>
    </div>
    <div class="budget-page-header__actions">
      <div class="budget-month-nav" aria-label="Budget month">
        <button type="button" class="budget-month-nav__arrow" id="budgetMonthPrev" aria-label="Previous month">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <span class="budget-month-nav__label" id="budgetMonthLabel"><%= monthTitle %></span>
        <button type="button" class="budget-month-nav__arrow" id="budgetMonthNext" aria-label="Next month">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <a href="<%= setupUrl %>" class="btn btn--primary budget-setup-link">Set or update budgets</a>
    </div>
  </header>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="budget-flash budget-flash--error">
    <% errors.forEach(function(error) { %>
      <p><%= error %></p>
    <% }); %>
  </div>
  <% } %>

  <% if (successMessage) { %>
  <div class="budget-flash budget-flash--success"><%= successMessage %></div>
  <% } %>

  <section class="budget-health" aria-labelledby="budgetHealthTitle">
    <div class="budget-health__head">
      <div>
        <h2 class="budget-health__title" id="budgetHealthTitle">Budget Health</h2>
        <p class="budget-health__subtitle"><%= healthStatus.helper %> &middot; <%= budgetMonthLabel %></p>
      </div>
      <span class="budget-health__pill budget-health__pill--<%= healthStatus.key %>"><%= healthStatus.label %></span>
    </div>

    <div class="budget-health__grid">
      <article class="budget-stat-card budget-stat-card--budget">
        <div class="budget-stat-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M8 3v4M16 3v4M4 10h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        </div>
        <div class="budget-stat-card__body">
          <span class="budget-stat-card__label">Monthly Budget</span>
          <span class="budget-stat-card__value"><%= formatMoney(summary.monthlyBudget) %></span>
          <span class="budget-stat-card__hint">Your spending limit for <%= budgetMonthLabel %></span>
        </div>
      </article>

      <article class="budget-stat-card budget-stat-card--spent">
        <div class="budget-stat-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.75"/></svg>
        </div>
        <div class="budget-stat-card__body">
          <span class="budget-stat-card__label">Total Spent</span>
          <span class="budget-stat-card__value"><%= formatMoney(summary.totalSpent) %></span>
          <span class="budget-stat-card__hint"><%= monthExpenseCount %> expense<%= monthExpenseCount === 1 ? '' : 's' %> this month</span>
        </div>
      </article>

      <article class="budget-stat-card budget-stat-card--<%= remainingKey %>">
        <div class="budget-stat-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v18M7 8l5-5 5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="budget-stat-card__body">
          <span class="budget-stat-card__label">Remaining</span>
          <span class="budget-stat-card__value"><%= formatRemaining(summary.remainingBudget, false) %></span>
          <span class="budget-stat-card__hint"><%= summary.remainingBudget < 0 ? 'Over your monthly limit' : 'Available to spend' %></span>
        </div>
      </article>

      <article class="budget-stat-card budget-stat-card--<%= summary.percentageUsed >= 100 ? 'danger' : (summary.percentageUsed >= 80 ? 'warning' : 'safe') %>">
        <div class="budget-stat-card__icon budget-stat-card__icon--ring" aria-hidden="true">
          <span class="budget-stat-card__ring"><%= summary.percentageUsed %>%</span>
        </div>
        <div class="budget-stat-card__body">
          <span class="budget-stat-card__label">Budget Used</span>
          <span class="budget-stat-card__value"><%= summary.percentageUsed %>%</span>
          <span class="budget-stat-card__hint">Of your monthly budget</span>
        </div>
      </article>
    </div>
  </section>

  <section class="budget-visuals" aria-label="Budget charts">
    <div class="budget-visuals__grid">
      <article class="budget-chart-panel">
        <div class="budget-chart-panel__head">
          <h2 class="budget-chart-panel__title">Category Spending</h2>
          <p class="budget-chart-panel__intro">Actual spending in <%= budgetMonthLabel %> from MySQL expenses.</p>
        </div>

        <% if (categorySpending.length > 0) { %>
        <div class="budget-hbar-chart" role="img" aria-label="Category spending chart">
          <% categorySpending.forEach(function(row) { %>
          <div class="budget-hbar-row">
            <div class="budget-hbar-row__label">
              <%- include('partials/category-icon', { catName: row.name, catIcon: row.icon, catSize: 'sm' }) %>
              <span class="budget-hbar-row__name"><%= row.name %></span>
            </div>
            <div class="budget-hbar-row__track-wrap">
              <div class="budget-hbar-row__track">
                <div class="budget-hbar-row__fill budget-hbar-row__fill--spend" style="width: <%= row.relativePct %>%;"></div>
              </div>
              <span class="budget-hbar-row__meta"><%= formatMoney(row.actual) %> &middot; <%= row.expenseCount %> expense<%= row.expenseCount === 1 ? '' : 's' %></span>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="budget-chart-empty">
          <p>No spending recorded for <%= budgetMonthLabel %> yet.</p>
          <p class="budget-chart-empty__hint">Expense records below may be from other months.</p>
        </div>
        <% } %>
      </article>

      <article class="budget-chart-panel">
        <div class="budget-chart-panel__head">
          <h2 class="budget-chart-panel__title">Budget Usage by Category</h2>
          <p class="budget-chart-panel__intro">
            <% if (hasCategoryBudgets) { %>
            How much of each category limit you have used in <%= budgetMonthLabel %>.
            <% } else { %>
            Set category limits to see progress bars and overspending alerts.
            <% } %>
          </p>
        </div>

        <% if (hasCategoryBudgets) { %>
        <div class="budget-hbar-chart" role="img" aria-label="Budget usage chart">
          <% categoryRows.forEach(function(row) { %>
          <div class="budget-hbar-row budget-hbar-row--usage">
            <div class="budget-hbar-row__label">
              <%- include('partials/category-icon', { catName: row.name, catIcon: row.icon, catSize: 'sm' }) %>
              <span class="budget-hbar-row__name"><%= row.name %></span>
              <span class="budget-badge budget-badge--sm <%= row.statusBadgeClass %>"><%= row.statusLabel %></span>
            </div>
            <div class="budget-hbar-row__track-wrap">
              <div class="budget-hbar-row__track">
                <div class="budget-hbar-row__fill <%= row.statusBarClass %>" style="width: <%= Math.min(row.usedPct, 100) %>%;"></div>
              </div>
              <span class="budget-hbar-row__meta">
                <%= formatMoney(row.actual) %> / <%= formatMoney(row.budgeted) %>
                &middot; <%= row.usedPct %>% used
                &middot; <%= formatRemaining(row.remaining, false) %> left
              </span>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="budget-chart-empty budget-chart-empty--cta">
          <div class="budget-chart-empty__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" width="56" height="56">
              <rect x="8" y="14" width="48" height="36" rx="6" stroke="currentColor" stroke-width="2"/>
              <path d="M8 24h48" stroke="currentColor" stroke-width="2"/>
              <circle cx="22" cy="36" r="4" stroke="currentColor" stroke-width="2"/>
              <path d="M34 34h16M34 40h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="budget-chart-empty__title">Start tracking category budgets</h3>
          <p class="budget-chart-empty__text">Set limits for categories to see progress bars and overspending alerts.</p>
          <a href="<%= setupUrl %>" class="btn btn--primary">Set or update budgets</a>
        </div>
        <% } %>
      </article>
    </div>
  </section>

  <% if (hasCategoryBudgets) { %>
  <section class="budget-panel budget-panel--cards">
    <div class="budget-panel__head">
      <h2 class="budget-panel__title">Category Budget Details</h2>
      <p class="budget-panel__intro">Limits saved for <%= budgetMonth %> &middot; spending from expenses in <%= budgetMonthLabel %></p>
    </div>

    <div class="budget-cat-grid">
      <% categoryRows.forEach(function(row) { %>
      <article class="budget-cat-card <%= row.statusCardClass %>">
        <div class="budget-cat-card__top">
          <%- include('partials/category-icon', { catName: row.name, catIcon: row.icon, catSize: 'md' }) %>
          <div class="budget-cat-card__heading">
            <h3 class="budget-cat-card__name"><%= row.name %></h3>
            <span class="budget-badge <%= row.statusBadgeClass %>"><%= row.statusLabel %></span>
          </div>
        </div>

        <div class="budget-cat-card__metrics">
          <div class="budget-cat-card__metric">
            <span class="budget-cat-card__metric-label">Budget</span>
            <span class="budget-cat-card__metric-value"><%= formatMoney(row.budgeted) %></span>
          </div>
          <div class="budget-cat-card__metric">
            <span class="budget-cat-card__metric-label">Spent</span>
            <span class="budget-cat-card__metric-value"><%= formatMoney(row.actual) %></span>
          </div>
          <div class="budget-cat-card__metric">
            <span class="budget-cat-card__metric-label">Remaining</span>
            <span class="budget-cat-card__metric-value budget-cat-card__metric-value--<%= row.remaining < 0 ? 'danger' : 'default' %>"><%= formatRemaining(row.remaining, false) %></span>
          </div>
        </div>

        <div class="budget-progress" role="progressbar" aria-valuenow="<%= Math.min(row.usedPct, 100) %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= row.name %> budget used">
          <div class="budget-progress__track">
            <div class="budget-progress__fill <%= row.statusBarClass %>" style="width: <%= Math.min(row.usedPct, 100) %>%;"></div>
          </div>
          <span class="budget-progress__label"><%= row.usedPct %>% used</span>
        </div>
      </article>
      <% }); %>
    </div>
  </section>
  <% } %>

  <section class="budget-card budget-card--expenses budget-card--expense-records">
    <div class="budget-expense-head">
      <div>
        <h2 class="budget-expense-records__title">Expense Records</h2>
        <p class="budget-expense-records__intro">Category totals use <%= monthExpenseCount %> expense<%= monthExpenseCount === 1 ? '' : 's' %> dated in <%= budgetMonthLabel %>. This list shows all <%= expenses.length %> record<%= expenses.length === 1 ? '' : 's' %> in the database.</p>
      </div>
      <span class="budget-expense-count"><%= expenses.length %> record<%= expenses.length === 1 ? '' : 's' %></span>
    </div>

    <ul class="budget-expense-list budget-expense-list--compact">
      <% expenses.forEach(function(expense) {
        var budgetCategory = getBudgetCategoryLabel(expense.category);
      %>
      <li class="budget-expense-item">
        <%- include('partials/category-icon', { catName: budgetCategory, catIcon: '', catSize: 'sm' }) %>
        <div class="budget-expense-item__main">
          <span class="budget-expense-item__title"><%= expense.description %></span>
          <span class="budget-expense-item__meta"><span class="budget-tag budget-tag--<%= budgetCategory.toLowerCase() %>"><%= budgetCategory %></span></span>
        </div>
        <span class="budget-expense-item__amount"><%= formatMoney(expense.amount) %></span>
      </li>
      <% }); %>
    </ul>

    <div class="budget-expense-total budget-expense-total--compact">
      <span class="budget-expense-total__label">Total spent in <%= budgetMonthLabel %></span>
      <span class="budget-expense-total__value"><%= formatMoney(summary.totalSpent) %></span>
    </div>
  </section>
</div>

<script>
(function () {
  "use strict";
  var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  var monthIndex = new Date().getMonth();
  var year = new Date().getFullYear();
  var label = document.getElementById("budgetMonthLabel");
  var prevBtn = document.getElementById("budgetMonthPrev");
  var nextBtn = document.getElementById("budgetMonthNext");

  function updateLabel() {
    if (label) {
      label.textContent = months[monthIndex] + " " + year + " Budget";
    }
  }

  if (prevBtn) {
    prevBtn.addEventListener("click", function () {
      monthIndex -= 1;
      if (monthIndex < 0) {
        monthIndex = 11;
        year -= 1;
      }
      updateLabel();
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener("click", function () {
      monthIndex += 1;
      if (monthIndex > 11) {
        monthIndex = 0;
        year += 1;
      }
      updateLabel();
    });
  }
})();
</script>

<%- include('partials/footer') %>
