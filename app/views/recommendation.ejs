<%- include('partials/header') %>

<section class="page-hero">
  <span class="page-label">Spending insight</span>
  <h1>Smart Spending Recommendation</h1>
  <p>Enter an item you want to buy. We use your current budget and sample expenses to suggest whether it is safe, risky, or not recommended.</p>
</section>

<div class="card-grid card-grid--spaced">
  <article class="card">
    <div class="card__icon card__icon--blue">💰</div>
    <h2>Monthly budget</h2>
    <p class="stat stat--blue">$<%= summary.monthlyBudget %></p>
  </article>
  <article class="card">
    <div class="card__icon card__icon--blue">📊</div>
    <h2>Total spent</h2>
    <p class="stat stat--blue">$<%= summary.totalSpent %></p>
    <p>From sample expenses</p>
  </article>
  <article class="card">
    <div class="card__icon card__icon--green">📈</div>
    <h2>Budget used</h2>
    <p class="stat stat--green"><%= summary.percentageUsed %>%</p>
  </article>
  <article class="card">
    <div class="card__icon card__icon--green">🔔</div>
    <h2>Remaining</h2>
    <p class="stat stat--green">$<%= summary.remainingBudget %></p>
  </article>
</div>

<section class="panel">
  <h2>Check an item</h2>
  <p class="panel-intro">Fill in the item details below. No database is used — calculations run from your current budget and sample expense data.</p>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="form-errors">
    <% errors.forEach(function(error) { %>
      <p><%= error %></p>
    <% }); %>
  </div>
  <% } %>

  <form class="budget-form recommendation-form" method="POST" action="/recommendation">
    <div class="form-group">
      <label for="itemName">Item name</label>
      <input
        type="text"
        id="itemName"
        name="itemName"
        placeholder="e.g. New headphones"
        required
        value="<%= typeof formValues !== 'undefined' && formValues.itemName ? formValues.itemName : '' %>"
      >
    </div>
    <div class="form-group">
      <label for="itemPrice">Item price ($)</label>
      <input
        type="number"
        id="itemPrice"
        name="itemPrice"
        min="0"
        step="0.01"
        placeholder="e.g. 49.99"
        required
        value="<%= typeof formValues !== 'undefined' && formValues.itemPrice !== undefined ? formValues.itemPrice : '' %>"
      >
    </div>
    <div class="form-group">
      <label for="category">Category</label>
      <select id="category" name="category" required>
        <option value="">Select a category</option>
        <% categories.forEach(function(cat) { %>
        <option value="<%= cat %>" <%= typeof formValues !== 'undefined' && formValues.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }); %>
      </select>
    </div>
    <button type="submit" class="btn btn--primary">Get recommendation</button>
  </form>
</section>

<% if (typeof recommendation !== 'undefined' && recommendation) { %>
<section class="panel recommendation-result recommendation-result--<%= recommendation.resultBadge %>">
  <h2>Recommendation: <%= recommendation.result %></h2>
  <p class="panel-intro">
    For <strong><%= recommendation.itemName %></strong> ($<%= recommendation.itemPrice %>) in category <strong><%= recommendation.category %></strong>
  </p>

  <div class="recommendation-badge">
    <span class="badge badge--<%= recommendation.resultBadge %>"><%= recommendation.result %></span>
  </div>

  <h3>Why?</h3>
  <ul class="recommendation-reasons">
    <% recommendation.reasons.forEach(function(reason) { %>
    <li><%= reason %></li>
    <% }); %>
  </ul>

  <h3>Analysis</h3>
  <div class="analysis-grid">
    <div class="analysis-item">
      <span class="analysis-label">Total spent (now)</span>
      <span class="analysis-value">$<%= recommendation.analysis.totalSpent %></span>
    </div>
    <div class="analysis-item">
      <span class="analysis-label">Remaining (now)</span>
      <span class="analysis-value">$<%= recommendation.analysis.remainingBudget %></span>
    </div>
    <div class="analysis-item">
      <span class="analysis-label">Budget used (now)</span>
      <span class="analysis-value"><%= recommendation.analysis.percentageUsed %>%</span>
    </div>
    <div class="analysis-item">
      <span class="analysis-label">After purchase</span>
      <span class="analysis-value">$<%= recommendation.analysis.newTotalSpent %> (<%= recommendation.analysis.newPercentageUsed %>%)</span>
    </div>
    <div class="analysis-item">
      <span class="analysis-label">Would exceed budget?</span>
      <span class="analysis-value"><%= recommendation.analysis.exceedsBudget ? 'Yes' : 'No' %></span>
    </div>
    <div class="analysis-item">
      <span class="analysis-label"><%= recommendation.category %> spent so far</span>
      <span class="analysis-value">$<%= recommendation.analysis.categoryTotal %> (<%= recommendation.analysis.categoryPercent %>%)</span>
    </div>
  </div>
</section>
<% } %>

<section class="panel">
  <h2>How recommendations work</h2>
  <div class="alert-rules">
    <div class="alert-rule">
      <span class="badge badge--success">Safe to buy</span>
      <span>Item fits in remaining budget and spending is under 80%</span>
    </div>
    <div class="alert-rule">
      <span class="badge badge--warning">Risky</span>
      <span>80%+ budget used, purchase pushes you near the limit, or category spending is already high</span>
    </div>
    <div class="alert-rule">
      <span class="badge badge--danger">Not recommended</span>
      <span>Item exceeds remaining budget or would go over your monthly limit</span>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
