<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | spendWise</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/confirm-modal.css?v=1">
  <% if (typeof activePage !== 'undefined' && activePage === 'budget') { %>
  <link rel="stylesheet" href="/modal-shell.css?v=4">
  <link rel="stylesheet" href="/spb.css?v=49">
  <% } %>
  <% if (typeof activePage !== 'undefined' && activePage === 'recommendation') { %>
  <link rel="stylesheet" href="/purchase-checker.css?v=1">
  <% } %>

</head>
<body class="app-body<%= typeof activePage !== 'undefined' && activePage === 'budget' ? ' app-body--spb' : '' %>">
  <div class="app-shell">
    <aside class="app-sidebar" id="appSidebar" aria-label="Main navigation">
      <a href="/" class="sidebar-brand" aria-label="spendWise home">
        <span class="logo-icon" aria-hidden="true">
          <svg class="logo-mark" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 9.5C3 7.567 4.567 6 6.5 6H17.5C19.433 6 21 7.567 21 9.5V18.5C21 20.433 19.433 22 17.5 22H6.5C4.567 22 3 20.433 3 18.5V9.5Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            <path d="M3 11H21" stroke="currentColor" stroke-width="1.75"/>
            <path d="M7 6V5.25C7 4.007 8.007 3 9.25 3H14.75C15.993 3 17 4.007 17 5.25V6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            <circle cx="17" cy="15.5" r="1.35" fill="currentColor"/>
            <path d="M6.5 3.75L8.25 6.25L10.75 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="sidebar-brand__text logo-text">spend<span class="logo-text-accent">Wise</span></span>
      </a>

      <nav class="sidebar-nav">
        <a href="/home" class="sidebar-link<%= activePage === 'landing' ? ' sidebar-link--active' : '' %>" title="Home">
          <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10.5L12 4l8 6.5V19a1 1 0 01-1 1h-5v-6H10v6H5a1 1 0 01-1-1v-8.5z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
          <span class="sidebar-link__label">Home</span>
        </a>
        <a href="/dashboard" class="sidebar-link<%= activePage === 'overview' ? ' sidebar-link--active' : '' %>" title="Overview">
          <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.75"/><rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.75"/><rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.75"/><rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.75"/></svg>
          <span class="sidebar-link__label">Overview</span>
        </a>
        <a href="/budget" class="sidebar-link<%= activePage === 'budget' ? ' sidebar-link--active' : '' %>" title="Spending &amp; Budgets">
          <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v18M7 8h10a3 3 0 010 6H9a3 3 0 000 6h10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="sidebar-link__label">Spending &amp; Budgets</span>
        </a>
        <a href="/chatbot" class="sidebar-link<%= activePage === 'chatbot' ? ' sidebar-link--active' : '' %>" title="FinBot">
          <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 8h10M7 12h6M5 4h14a2 2 0 012 2v9a2 2 0 01-2 2H9l-4 3v-3H5a2 2 0 01-2-2V6a2 2 0 012-2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
          <span class="sidebar-link__label">FinBot</span>
        </a>
        <a href="/recommendation" class="sidebar-link<%= activePage === 'recommendation' ? ' sidebar-link--active' : '' %>" title="Purchase Checker">
          <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 4-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="sidebar-link__label">Purchase Checker</span>
        </a>
        <a href="/expenses" class="sidebar-link<%= activePage === 'expenses' ? ' sidebar-link--active' : '' %>" title="Add Expenses">
          <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
          <span class="sidebar-link__label">Add Expenses</span>
        </a>
        <%# Monthly Report: no route or DB table yet (see db/init.sql) — placeholder link only %>
        <a href="#" class="sidebar-link sidebar-link--soon" title="Monthly Report">
          <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 4h10v16H7zM9 8h6M9 12h6M9 16h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="sidebar-link__label">Monthly Report</span>
        </a>
        <a href="/savings-goals" class="sidebar-link<%= activePage === 'savings-goals' ? ' sidebar-link--active' : '' %>" title="Savings Goal">
          <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.75"/><path d="M12 8v4l3 2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
          <span class="sidebar-link__label">Savings Goal</span>
        </a>
      </nav>

      <div style="margin-top:auto;padding:1rem;border-top:1px solid var(--sidebar-border);">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a href="/profile" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'profile' ? ' sidebar-link--active' : '' %>" title="Profile">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.75"/><path d="M4 20c0-4 3.5-6 8-6s8 2 8 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
            <span class="sidebar-link__label"><%= currentUser.name %></span>
          </a>
          <form method="POST" action="/logout" style="margin:0;">
            <button type="submit" class="sidebar-link" style="width:100%;background:none;border:none;cursor:pointer;text-align:left;" title="Log Out">
              <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="sidebar-link__label">Log Out</span>
            </button>
          </form>
        <% } else { %>
          <a href="/login" class="sidebar-link<%= typeof activePage !== 'undefined' && activePage === 'login' ? ' sidebar-link--active' : '' %>" title="Log In">
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="sidebar-link__label">Log In</span>
          </a>
        <% } %>
      </div>
    </aside>

    <div class="app-main">
      <header class="app-topbar">
        <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="appSidebar">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <h1 class="topbar-title"><%= pageTitle %></h1>
      </header>

      <main class="app-content<%= typeof activePage !== 'undefined' && activePage === 'landing' ? ' app-content--landing' : '' %>">
