<%
  var _title = typeof expenseTitle !== 'undefined' ? expenseTitle : 'Expense';
  var _path = typeof imagePath !== 'undefined' ? imagePath : '';
  var _link = typeof thumbLink !== 'undefined' ? thumbLink : '';
  var _size = typeof thumbSize !== 'undefined' ? thumbSize : 'md';
%>
<% if (_path) { %>
  <% if (_link) { %><a href="<%= _link %>" class="expense-thumb-link"><% } %>
    <img src="<%= _path %>" alt="<%= _title %> receipt" class="expense-thumb expense-thumb--<%= _size %>">
  <% if (_link) { %></a><% } %>
<% } else { %>
  <div class="expense-no-image expense-no-image--<%= _size %>" title="No image">
    <svg viewBox="0 0 24 24" fill="none" width="26" height="26" aria-hidden="true">
      <path d="M4 7h16l-2 12H6L4 7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="12" cy="13" r="2.5" stroke="currentColor" stroke-width="1.5"/>
    </svg>
    <span>No image</span>
  </div>
<% } %>
