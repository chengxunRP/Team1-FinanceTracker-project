<div class="sw-confirm-overlay" id="swConfirmOverlay" hidden>
  <div class="sw-confirm" role="alertdialog" aria-modal="true" aria-labelledby="swConfirmTitle" aria-describedby="swConfirmMessage">
    <h2 class="sw-confirm__title" id="swConfirmTitle">Are you sure?</h2>
    <p class="sw-confirm__message" id="swConfirmMessage">This cannot be undone.</p>
    <div class="sw-confirm__actions">
      <button type="button" class="sw-confirm__cancel" id="swConfirmCancel">Cancel</button>
      <button type="button" class="sw-confirm__action sw-confirm__action--danger" id="swConfirmAction">Delete</button>
    </div>
  </div>
</div>
