<%
  var _name = typeof catName !== 'undefined' ? catName : (typeof name !== 'undefined' ? name : '');
  var _icon = typeof catIcon !== 'undefined' ? catIcon : (typeof icon !== 'undefined' ? icon : '');
  var _iconImage = typeof catIconImage !== 'undefined' ? catIconImage : (typeof iconImage !== 'undefined' ? iconImage : '');
  var _color = typeof catColor !== 'undefined' ? catColor : (typeof color !== 'undefined' ? color : '');
  var _size = typeof catSize !== 'undefined' ? catSize : 'md';
  var _isCustom = typeof catIsCustom !== 'undefined' ? catIsCustom : undefined;

  var _visual = null;
  if (typeof getCategoryVisual === 'function') {
    _visual = getCategoryVisual({
      name: _name,
      displayName: _name,
      icon: _icon,
      iconImage: _iconImage,
      icon_image: _iconImage,
      color: _color,
      is_custom: _isCustom,
      isCustom: _isCustom
    });
  }

  var _customMarkup = '';
  if (!_visual && typeof getCustomCategoryIconMarkup === 'function' && _icon && _icon !== 'default-category' && _icon !== 'others') {
    _customMarkup = getCustomCategoryIconMarkup(_icon, _size);
  }

  var _imgUrl = '';
  if (_visual && (_visual.type === 'image' || _visual.type === 'generalIcon')) {
    _imgUrl = _visual.src || '';
  } else if (!_iconImage && !_customMarkup && typeof getCategoryImageUrl === 'function') {
    _imgUrl = getCategoryImageUrl(_name, _icon);
  } else if (_iconImage) {
    _imgUrl = _iconImage;
  }

  var _useColorFallback = false;
  if (_visual && _visual.type === 'color') {
    _color = _visual.color || _color;
    _useColorFallback = !!_color;
  } else if (!_imgUrl && !_customMarkup && _color) {
    _useColorFallback = true;
  }

  var _lightCustomColor = false;
  if (_useColorFallback && /^#[0-9A-Fa-f]{6}$/.test(_color)) {
    var _r = parseInt(_color.slice(1, 3), 16);
    var _g = parseInt(_color.slice(3, 5), 16);
    var _b = parseInt(_color.slice(5, 7), 16);
    _lightCustomColor = ((_r * 299 + _g * 587 + _b * 114) / 1000) > 180;
  }
  var _customColorClass = _useColorFallback ? ' sw-category-icon--custom-color' + (_lightCustomColor ? ' sw-category-icon--custom-color-light' : '') : '';
  var _uploadClass = (_visual && _visual.type === 'image') || _iconImage ? ' sw-category-icon--upload' : '';
%>
<span class="sw-category-icon sw-category-icon--<%= _size %><%= _customColorClass %><%= _uploadClass %>"<% if (_name) { %> title="<%= _name %>"<% } %><% if (_useColorFallback) { %> style="--sw-cat-color:<%= _color %>"<% } %>>
  <% if (_imgUrl) { %>
    <img src="<%= _imgUrl %>" alt="" class="sw-category-icon__img<%= (_visual && _visual.type === 'image') || _iconImage ? ' sw-category-icon__img--upload' : '' %>" loading="lazy">
  <% } else if (_customMarkup) { %>
    <%- _customMarkup %>
  <% } else if (_useColorFallback) { %>
    <span class="sw-category-icon__fallback" aria-hidden="true"></span>
  <% } else { %>
    <span class="sw-category-icon__fallback" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"/>
        <path d="M8.5 12h7M12 8.5v7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
    </span>
  <% } %>
</span>
