<%- include('../partials/header') %>

<div style="display:flex;justify-content:center;padding:2rem 0;">
  <div class="card-panel" style="width:100%;max-width:420px;">
    <div class="page-header" style="margin-bottom:1.25rem;">
      <span class="eyebrow">Finance Tracker</span>
      <h1>Forgot password</h1>
      <p>Enter your email and we will send a reset link if your account exists.</p>
    </div>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="form-errors">
        <% errors.forEach(function(err) { %><p>⚠ <%= err %></p><% }) %>
      </div>
    <% } %>

    <% if (typeof infoMessage !== 'undefined' && infoMessage) { %>
      <div style="background:#eff6ff;border:1px solid #93c5fd;color:#1e3a8a;padding:0.75rem 0.9rem;border-radius:var(--radius-sm);font-size:0.9rem;font-weight:600;margin-bottom:0.9rem;">
        <%= infoMessage %>
      </div>
    <% } %>

    <form method="POST" action="/forgot-password" style="display:grid;gap:1rem;">
      <div class="form-group">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="you@example.com"
          value="<%= typeof formValues !== 'undefined' ? (formValues.email || '') : '' %>"
          required
          autofocus
          style="padding:0.7rem 0.9rem;border:1px solid var(--grey-300);border-radius:var(--radius-sm);font-size:0.9rem;color:var(--text);background:var(--white);width:100%;"
        >
      </div>

      <button type="submit" class="btn btn--primary btn--sm btn--block">
        Send reset link
      </button>
    </form>

    <p style="text-align:center;margin-top:1rem;font-size:0.85rem;color:var(--text-muted);">
      <a href="/login" style="color:var(--blue-mid);font-weight:600;">Back to login</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
