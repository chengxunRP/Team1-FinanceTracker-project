<%- include('../partials/header') %>

<div style="display:flex;justify-content:center;padding:2rem 0;">
  <div class="card-panel" style="width:100%;max-width:440px;">
    <div class="page-header" style="margin-bottom:1.25rem;">
      <span class="eyebrow">Finance Tracker</span>
      <h1>Reset password</h1>
      <p>Choose a new password for your spendWise account.</p>
    </div>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="form-errors">
        <% errors.forEach(function(err) { %><p>⚠ <%= err %></p><% }) %>
      </div>
    <% } %>

    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div style="background:#e6f7ec;border:1px solid #43a047;color:#2e7d32;padding:0.75rem 0.9rem;border-radius:var(--radius-sm);font-size:0.9rem;font-weight:600;margin-bottom:0.9rem;">
        ✓ <%= successMessage %>
      </div>
    <% } %>

    <% if (tokenValid) { %>
      <form method="POST" action="/reset-password/<%= encodeURIComponent(resetToken) %>" style="display:grid;gap:1rem;">
        <div class="form-group">
          <label for="password">New password</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="8"
            autocomplete="new-password"
            placeholder="At least 8 characters"
            style="padding:0.7rem 0.9rem;border:1px solid var(--grey-300);border-radius:var(--radius-sm);font-size:0.9rem;color:var(--text);background:var(--white);width:100%;"
          >
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm new password</label>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            required
            minlength="8"
            autocomplete="new-password"
            placeholder="Re-enter your new password"
            style="padding:0.7rem 0.9rem;border:1px solid var(--grey-300);border-radius:var(--radius-sm);font-size:0.9rem;color:var(--text);background:var(--white);width:100%;"
          >
        </div>

        <p style="margin:0;font-size:0.8rem;color:var(--text-muted);line-height:1.45;">
          Password must be at least 8 characters and include at least 1 letter and 1 number.
        </p>

        <button type="submit" class="btn btn--primary btn--sm btn--block">
          Update password
        </button>
      </form>
    <% } else { %>
      <p style="margin:0.2rem 0 0.9rem;color:var(--text-muted);font-size:0.9rem;">
        This link may be invalid, expired, or already used.
      </p>
      <a href="/forgot-password" class="btn btn--sm btn--block" style="background:var(--grey-200,#eee);border:none;">
        Request a new reset link
      </a>
    <% } %>

    <p style="text-align:center;margin-top:1rem;font-size:0.85rem;color:var(--text-muted);">
      <a href="/login" style="color:var(--blue-mid);font-weight:600;">Back to login</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
