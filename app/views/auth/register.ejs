<%- include('../partials/header') %>

<div style="display:flex;justify-content:center;padding:2rem 0;">
  <div class="card-panel" style="width:100%;max-width:400px;">

    <div class="page-header" style="margin-bottom:1.25rem;">
      <span class="eyebrow">Finance Tracker</span>
      <h1>Create your account</h1>
      <p>Track your own expenses, budget, and savings goals.</p>
    </div>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="form-errors">
        <% errors.forEach(function(err) { %><p>⚠ <%= err %></p><% }) %>
      </div>
    <% } %>

    <form method="POST" action="/register" style="display:grid;gap:1rem;">

      <div class="form-group">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" placeholder="e.g. Sherlyn"
          value="<%= typeof formValues !== 'undefined' ? (formValues.name || '') : '' %>"
          required autofocus
          style="padding:0.7rem 0.9rem;border:1px solid var(--grey-300);border-radius:var(--radius-sm);font-size:0.9rem;color:var(--text);background:var(--white);width:100%;">
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="you@example.com"
          value="<%= typeof formValues !== 'undefined' ? (formValues.email || '') : '' %>"
          required
          style="padding:0.7rem 0.9rem;border:1px solid var(--grey-300);border-radius:var(--radius-sm);font-size:0.9rem;color:var(--text);background:var(--white);width:100%;">
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="At least 8 characters"
          required minlength="8" autocomplete="new-password"
          style="padding:0.7rem 0.9rem;border:1px solid var(--grey-300);border-radius:var(--radius-sm);font-size:0.9rem;color:var(--text);background:var(--white);width:100%;">
        <p class="form-hint" style="margin:0.4rem 0 0;font-size:0.8rem;color:var(--text-muted);line-height:1.4;">
          Password must be at least 8 characters and include at least 1 letter and 1 number.
        </p>
        <p id="passwordError" class="form-errors" hidden style="margin-top:0.5rem;">
          Password must be at least 8 characters and include at least 1 letter and 1 number.
        </p>
      </div>

      <button type="submit" class="btn btn--primary btn--sm btn--block" style="margin-top:0.25rem;">
        Create Account
      </button>
    </form>

    <p style="text-align:center;margin-top:1.25rem;font-size:0.85rem;color:var(--text-muted);">
      Already have an account? <a href="/login" style="color:var(--blue-mid);font-weight:600;">Log in</a>
    </p>

  </div>
</div>

<script>
(function () {
  var form = document.querySelector('form[action="/register"]');
  if (!form) return;

  var passwordInput = document.getElementById("password");
  var passwordError = document.getElementById("passwordError");
  var message =
    "Password must be at least 8 characters and include at least 1 letter and 1 number.";

  function isValidPassword(value) {
    if (!value || value.length < 8) return false;
    if (!/[A-Za-z]/.test(value)) return false;
    if (!/\d/.test(value)) return false;
    return true;
  }

  form.addEventListener("submit", function (event) {
    if (!passwordInput || isValidPassword(passwordInput.value)) return;
    event.preventDefault();
    if (passwordError) {
      passwordError.hidden = false;
      passwordError.textContent = message;
    }
    passwordInput.focus();
  });

  if (passwordInput) {
    passwordInput.addEventListener("input", function () {
      if (passwordError && isValidPassword(passwordInput.value)) {
        passwordError.hidden = true;
      }
    });
  }
})();
</script>

<%- include('../partials/footer') %>