<%- include('../partials/header') %>

<%
  function catIconSvg(icon) {
    var map = {
      food:          '<svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true"><path d="M12 21c4-4 6-7.5 6-11a6 6 0 10-12 0c0 3.5 2 7 6 11z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><circle cx="12" cy="11" r="2" stroke="currentColor" stroke-width="1.75"/></svg>',
      transport:     '<svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true"><path d="M5 17h14M5 17a2 2 0 100-4 2 2 0 000 4zM19 17a2 2 0 100-4 2 2 0 000 4zM5 17V8l2-3h10l2 3v9" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>',
      school:        '<svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true"><path d="M12 3L2 8l10 5 10-5-10-5z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M6 10.5V17c2 2 8 2 12 0v-6.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>',
      shopping:      '<svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true"><path d="M7 9V7a5 5 0 0110 0v2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><path d="M6 9h12l-1 12H7L6 9z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>',
      bills:         '<svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true"><path d="M8 4h8l2 4v12H6V4h2z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M9 12h6M9 16h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>',
      entertainment: '<svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true"><rect x="4" y="6" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M10 9.5l5 3-5 3v-6z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>',
      health:        '<svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true"><path d="M4.5 12.5h3l2-7 3 14 2-9 1.5 2H20" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      travel:        '<svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true"><path d="M22 16.5H2M5 16.5V7a1 1 0 011-1h12a1 1 0 011 1v9.5M9 6V4h6v2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      others:        '<svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"/><path d="M8.5 12h7M12 8.5v7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>'
    };
    return map[icon] || map.others;
  }
%>

<div style="display:flex;flex-direction:column;gap:1.25rem;width:100%;max-width:none;">

  <!-- Page header -->
  <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
    <div class="page-header" style="margin-bottom:0;">
      <a href="/expenses" style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.82rem;font-weight:600;color:var(--text-muted);text-decoration:none;margin-bottom:0.5rem;"
         onmouseover="this.style.color='var(--blue-mid)'" onmouseout="this.style.color='var(--text-muted)'">
        <svg viewBox="0 0 24 24" fill="none" width="14" height="14" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to Expenses
      </a>
      <span class="eyebrow">Expense Detail</span>
      <h1>Record</h1>
    </div>
    <div style="display:flex;gap:0.65rem;">
      <a href="/expenses/<%= expense.id %>/edit" class="btn btn--sm" style="background:var(--blue-light);color:var(--blue);border:1px solid transparent;">
        <svg viewBox="0 0 24 24" fill="none" width="13" height="13" style="margin-right:0.3rem" aria-hidden="true"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Edit
      </a>
      <form method="POST" action="/expenses/<%= expense.id %>" style="display:inline;" onsubmit="return confirm('Delete this expense?')">
        <input type="hidden" name="_method" value="DELETE">
        <button type="submit" class="btn btn--sm" style="background:var(--danger-light);color:var(--danger);border:1px solid transparent;cursor:pointer;font-family:inherit;">
          <svg viewBox="0 0 24 24" fill="none" width="13" height="13" style="margin-right:0.3rem" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Delete
        </button>
      </form>
    </div>
  </div>

  <!-- Detail card -->
  <div class="card-panel" style="max-width:560px;border-left:4px solid <%= expense.category.color %>;">

    <!-- Category badge -->
    <div style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.3rem 0.85rem;border-radius:999px;font-size:0.8rem;font-weight:600;background:<%= expense.category.color %>15;color:<%= expense.category.color %>;margin-bottom:1rem;">
      <span style="color:<%= expense.category.color %>;"><%- catIconSvg(expense.category.icon) %></span>
      <%= expense.category.name %>
    </div>

    <!-- Title -->
    <h2 style="margin:0 0 0.5rem;font-size:1.45rem;font-weight:800;letter-spacing:-0.03em;color:var(--text);"><%= expense.title %></h2>

    <!-- Amount -->
    <div style="font-size:2.5rem;font-weight:800;letter-spacing:-0.04em;color:var(--blue-mid);margin-bottom:0.65rem;line-height:1.1;"><%= formatSGD(expense.amount) %></div>

    <!-- Expense image -->
    <div class="expense-detail-image-wrap">
      <% if (expense.imagePath) { %>
        <img src="<%= expense.imagePath %>" alt="<%= expense.title %> receipt" class="expense-detail-image">
      <% } else { %>
        <div class="expense-detail-no-image">
          <svg viewBox="0 0 24 24" fill="none" width="36" height="36" aria-hidden="true">
            <path d="M4 7h16l-2 12H6L4 7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="12" cy="13" r="2.5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span>No image uploaded</span>
        </div>
      <% } %>
    </div>

    <!-- Date -->
    <div style="display:inline-flex;align-items:center;gap:0.45rem;font-size:0.875rem;color:var(--text-muted);margin-bottom:<%= expense.notes ? '1.25rem' : '0' %>;">
      <svg viewBox="0 0 24 24" fill="none" width="15" height="15" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.75"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
      <%= new Date(expense.date + 'T00:00:00').toLocaleDateString('en-SG', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %>
    </div>

    <!-- Notes -->
    <% if (expense.notes) { %>
      <div style="border-top:1px solid var(--border-soft);padding-top:1.15rem;margin-top:0.5rem;">
        <span style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);display:block;margin-bottom:0.4rem;">Notes</span>
        <p style="margin:0;font-size:0.9rem;color:var(--text-muted);line-height:1.6;"><%= expense.notes %></p>
      </div>
    <% } %>

  </div>

</div>

<script src="/js/expense-nav.js"></script>
<%- include('../partials/footer') %>
