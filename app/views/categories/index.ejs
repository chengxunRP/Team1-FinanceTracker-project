<%- include('../partials/header') %>

<div style="display:flex;flex-direction:column;gap:1.25rem;width:100%;max-width:none;">

  <!-- Page header -->
  <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
    <div class="page-header" style="margin-bottom:0;">
      <a href="/expenses" style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.82rem;font-weight:600;color:var(--text-muted);text-decoration:none;margin-bottom:0.5rem;"
         onmouseover="this.style.color='var(--blue-mid)'" onmouseout="this.style.color='var(--text-muted)'">
        <svg viewBox="0 0 24 24" fill="none" width="14" height="14" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to Expenses
      </a>
      <span class="eyebrow">Finance Tracker</span>
      <h1>Categories</h1>
      <p>Organise your spending into meaningful groups.</p>
    </div>
  </div>

  <!-- Error messages -->
  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="form-errors">
      <% errors.forEach(function(err) { %><p>⚠ <%= err %></p><% }) %>
    </div>
  <% } %>

  <div style="display:grid;grid-template-columns:1fr 320px;gap:1.5rem;align-items:start;">

    <!-- Left: category list -->
    <div>
      <% if (categories.length === 0) { %>
        <div class="card-panel" style="text-align:center;padding:3rem 2rem;">
          <p style="color:var(--text-muted);margin:0;">No categories yet. Add one using the form →</p>
        </div>
      <% } else { %>
        <div style="display:flex;flex-direction:column;gap:0.5rem;">
          <% categories.forEach(function(cat) { %>
            <div class="card-panel" style="padding:1rem 1.25rem;border-left:4px solid <%= cat.color %>;display:flex;align-items:center;gap:1rem;margin-bottom:0;">

              <!-- Icon -->
              <%- include('../partials/category-icon', { catName: cat.name, catIcon: cat.icon, catSize: 'md' }) %>

              <!-- Info -->
              <div style="flex:1;min-width:0;">
                <div style="font-weight:700;font-size:0.95rem;color:var(--text);"><%= cat.displayName || cat.name %></div>
                <div style="font-size:0.775rem;color:var(--text-muted);margin-top:0.15rem;">
                  <span><%= cat.count %> expense<%= cat.count !== 1 ? 's' : '' %></span>
                  <% if (cat.count > 0) { %>
                    <span style="margin:0 0.35rem;opacity:0.4;">·</span>
                    <span style="color:<%= cat.color %>;font-weight:600;">$<%= cat.total.toFixed(2) %> total</span>
                  <% } %>
                </div>
              </div>

              <!-- Actions -->
              <div style="display:flex;gap:0.35rem;flex-shrink:0;">
                <a href="/categories/<%= cat.id %>/edit"
                   style="display:inline-flex;align-items:center;gap:0.3rem;padding:0.3rem 0.65rem;border-radius:var(--radius-sm);font-size:0.78rem;font-weight:600;text-decoration:none;background:var(--blue-light);color:var(--blue);transition:all 0.15s;"
                   onmouseover="this.style.background='var(--blue)';this.style.color='var(--white)'"
                   onmouseout="this.style.background='var(--blue-light)';this.style.color='var(--blue)'">
                  <svg viewBox="0 0 24 24" fill="none" width="12" height="12" aria-hidden="true"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Edit
                </a>
                <% if (cat.count === 0) { %>
                  <form method="POST" action="/categories/<%= cat.id %>" style="display:inline;"
                        data-confirm
                        data-confirm-title="Are you sure?"
                        data-confirm-message="This cannot be undone."
                        data-confirm-action-text="Delete"
                        data-confirm-type="danger">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit"
                      style="display:inline-flex;align-items:center;gap:0.3rem;padding:0.3rem 0.65rem;border-radius:var(--radius-sm);font-size:0.78rem;font-weight:600;background:var(--danger-light);color:var(--danger);border:none;cursor:pointer;transition:all 0.15s;font-family:inherit;"
                      onmouseover="this.style.background='var(--danger)';this.style.color='var(--white)'"
                      onmouseout="this.style.background='var(--danger-light)';this.style.color='var(--danger)'">
                      <svg viewBox="0 0 24 24" fill="none" width="12" height="12" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      Delete
                    </button>
                  </form>
                <% } else { %>
                  <span title="Cannot delete a category with expenses"
                    style="display:inline-flex;align-items:center;gap:0.3rem;padding:0.3rem 0.65rem;border-radius:var(--radius-sm);font-size:0.78rem;font-weight:600;background:var(--grey-100);color:var(--grey-300);cursor:not-allowed;">
                    <svg viewBox="0 0 24 24" fill="none" width="12" height="12" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Delete
                  </span>
                <% } %>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Right: add form -->
    <div class="card-panel" style="position:sticky;top:calc(var(--topbar-height) + 1rem);">
      <h2 style="margin:0 0 0.25rem;font-size:1rem;font-weight:700;">Add New Category</h2>
      <p style="margin:0 0 1.15rem;font-size:0.85rem;color:var(--text-muted);">Create a custom spending group.</p>

      <form method="POST" action="/categories" style="display:grid;gap:1rem;">

        <div class="form-group">
          <label for="name">Category Name</label>
          <input type="text" id="name" name="name" placeholder="e.g. Healthcare"
            value="<%= typeof formValues !== 'undefined' ? (formValues.name || '') : '' %>"
            required autofocus
            style="padding:0.7rem 0.9rem;border:1px solid var(--grey-300);border-radius:var(--radius-sm);font-size:0.9rem;color:var(--text);background:var(--white);width:100%;">
        </div>

        <!-- Icon picker -->
        <div class="form-group">
          <label style="font-size:0.875rem;font-weight:600;display:block;margin-bottom:0.4rem;">Icon</label>
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
            <% icons.forEach(function(icon, i) {
              var selectedIcon = typeof formValues !== 'undefined' && formValues.icon ? formValues.icon : icons[0];
            %>
              <label style="cursor:pointer;">
                <input type="radio" name="icon" value="<%= icon %>" <%= selectedIcon === icon ? 'checked' : '' %> style="display:none;">
                <span class="icon-picker-pill" data-icon="<%= icon %>"
                  style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:var(--radius-sm);border:1.5px solid <%= selectedIcon === icon ? 'var(--blue-mid)' : 'var(--border-soft)' %>;background:<%= selectedIcon === icon ? 'var(--blue-light)' : 'var(--white)' %>;font-size:0.75rem;font-weight:700;color:var(--text-muted);cursor:pointer;transition:all 0.15s;text-transform:capitalize;">
                  <%= icon.substring(0,3) %>
                </span>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- Color picker -->
        <div class="form-group">
          <label style="font-size:0.875rem;font-weight:600;display:block;margin-bottom:0.4rem;">Color</label>
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
            <% colors.forEach(function(col, i) {
              var selectedColor = typeof formValues !== 'undefined' && formValues.color ? formValues.color : colors[0].value;
            %>
              <label style="cursor:pointer;">
                <input type="radio" name="color" value="<%= col.value %>" <%= selectedColor === col.value ? 'checked' : '' %> style="display:none;">
                <span class="color-picker-swatch"
                  style="display:block;width:28px;height:28px;border-radius:50%;background:<%= col.value %>;border:2.5px solid <%= selectedColor === col.value ? 'var(--text)' : 'transparent' %>;cursor:pointer;transition:all 0.15s;transform:<%= selectedColor === col.value ? 'scale(1.2)' : 'scale(1)' %>;"
                  title="<%= col.label %>">
                </span>
              </label>
            <% }) %>
          </div>
        </div>

        <button type="submit" class="btn btn--primary btn--sm btn--block" style="margin-top:0.25rem;">
          <svg viewBox="0 0 24 24" fill="none" width="14" height="14" style="margin-right:0.35rem" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/></svg>
          Add Category
        </button>
      </form>
    </div>

  </div>
</div>

<script>
// Icon picker highlight
document.querySelectorAll('input[name="icon"]').forEach(function(r) {
  r.addEventListener('change', function() {
    document.querySelectorAll('.icon-picker-pill').forEach(function(p) {
      p.style.borderColor = 'var(--border-soft)';
      p.style.background = 'var(--white)';
    });
    var pill = this.nextElementSibling;
    pill.style.borderColor = 'var(--blue-mid)';
    pill.style.background = 'var(--blue-light)';
  });
});
// Color picker highlight
document.querySelectorAll('input[name="color"]').forEach(function(r) {
  r.addEventListener('change', function() {
    document.querySelectorAll('.color-picker-swatch').forEach(function(s) {
      s.style.border = '2.5px solid transparent';
      s.style.transform = 'scale(1)';
    });
    var swatch = this.nextElementSibling;
    swatch.style.border = '2.5px solid var(--text)';
    swatch.style.transform = 'scale(1.2)';
  });
});
</script>

<script src="/js/expense-nav.js"></script>
<%- include('../partials/footer') %>
